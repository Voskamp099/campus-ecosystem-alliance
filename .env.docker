# ============================================
# Docker Compose 环境变量配置
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 修改下面的配置项
# 3. 运行 docker-compose up -d
# ============================================

# 服务端口
PORT=3000

# JWT 配置
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 后台管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# MySQL 配置
MYSQL_ROOT_PASSWORD=root_password_change_this
MYSQL_DATABASE=alliance_website
MYSQL_USER=alliance
MYSQL_PASSWORD=alliance_password_change_this
MYSQL_CONNECTION_LIMIT=10
MYSQL_EXTERNAL_PORT=3306

# API 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS 配置
CORS_ORIGIN=*

# 日志级别
LOG_LEVEL=info

# Sentry 错误追踪（可选，生产环境推荐）
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# SMTP 邮件服务（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@example.com
# SITE_URL=https://your-domain.com

# 火山引擎 TOS 对象存储（可选）
# TOS_REGION=cn-beijing
# TOS_ENDPOINT=tos-cn-beijing.volces.com
# TOS_BUCKET=your-bucket-name
# TOS_ACCESS_KEY=your-access-key
# TOS_SECRET_KEY=your-secret-key
# TOS_PUBLIC_BASE_URL=https://your-bucket.tos-cn-beijing.volces.com
