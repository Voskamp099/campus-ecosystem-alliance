# ================================
# 北京校园生态合作联盟 · 环境变量配置
# 复制本文件为 .env，然后填入实际值
# ================================

# ---------- 服务器 ----------
NODE_ENV=development
PORT=3000

# ---------- 日志 ----------
# 日志级别：trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# ---------- 后台管理员 ----------
# 后台登录账号（默认：admin）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@alliance.local

# 后台登录密码（请务必修改为强密码）
ADMIN_PASSWORD=your_secure_password_here

# JWT 密钥（请务必修改为随机字符串，推荐 32 位以上）
# 示例生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- MySQL 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=alliance_website
MYSQL_CONNECTION_LIMIT=10

# ---------- 安全配置 ----------
# CSRF 密钥（请务必修改为随机字符串，推荐 32 位以上）
CSRF_SECRET=change_me_to_a_random_string

# Sentry 错误追踪（可选，生产环境推荐配置）
# 获取方式：https://sentry.io/
SENTRY_DSN=

# Rate Limiting（API 限流）
# 时间窗口（毫秒），默认 15 分钟
RATE_LIMIT_WINDOW_MS=900000
# 每个 IP 在时间窗口内的最大请求数
RATE_LIMIT_MAX=100

# ---------- CORS 配置 ----------
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ---------- 邮件服务（可选） ----------
# 用于发送验证邮件、密码重置等
# 推荐使用：阿里云邮件推送、腾讯企业邮箱、SendGrid 等
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alliance.local

# 网站公开访问地址（用于生成邮件中的链接）
# 示例：https://alliance.example.com
SITE_URL=http://localhost:3000

# ---------- 火山引擎对象存储 TOS（可选） ----------
# 图片上传功能需要配置此项。如暂不使用图片上传功能，可以留空。
# TOS_REGION：区域，如 cn-beijing、cn-guangzhou
TOS_REGION=
# TOS_ENDPOINT：对象存储入口，如 tos-cn-beijing.ivolces.com
TOS_ENDPOINT=
# TOS_BUCKET：存储桶名称
TOS_BUCKET=
# TOS_ACCESS_KEY：访问密钥 ID
TOS_ACCESS_KEY=
# TOS_SECRET_KEY：访问密钥 Secret
TOS_SECRET_KEY=
# TOS_PUBLIC_BASE_URL：图片的公开访问地址（末尾不要带 /）
TOS_PUBLIC_BASE_URL=

# 上传文件大小限制（单位：MB）
MAX_UPLOAD_SIZE_MB=10
